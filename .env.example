# Copie este arquivo para .env.local e preencha com os seus valores.
# O .env.local NUNCA deve ir para o Git.

# String de conexão do banco (Neon). Copie do painel do Neon ou da Vercel.
DATABASE_URL=postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Chave usada para apagar comentários (rota DELETE).
ADMIN_KEY=troque-por-uma-chave-longa
